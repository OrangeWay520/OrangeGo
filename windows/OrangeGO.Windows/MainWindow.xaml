<Window x:Class="OrangeGO.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:OrangeGO.Windows"
        Title="OrangeGO" Height="640" Width="920"
        Icon="pack://application:,,,/Assets/logo.png"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <!-- CaptionHeight=0：右侧三个窗口按钮归我们自绘，四边仍可缩放；DWM 负责圆角与过渡动画 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:ProgressRingConverter x:Key="RingConv"/>
        <local:RoundedRectConverter x:Key="RoundClip"/>
        <local:PathThumbConverter x:Key="PathThumb"/>
        <Style x:Key="PendingRemoveTemplate" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Width="22" Height="22" CornerRadius="11" Background="#C2000000">
                            <!-- Font Awesome xmark：白色矢量，Stretch 居中缩放，避免被裁切 -->
                            <Path Data="M342.6 150.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L192 210.7 86.6 105.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L146.7 256 41.4 361.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0L192 301.3 297.4 406.6c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L237.3 256 342.6 150.6z"
                                  Fill="White" Width="13" Height="13" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E6000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PageHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <!-- 右上角窗口按钮：MDL2 标准图标 + 细腻悬停 -->
        <Style x:Key="WinButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WinCloseStyle" TargetType="Button" BasedOn="{StaticResource WinButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource DangerBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 聊天功能键：表情/文件/截图等 -->
        <Style x:Key="ChatToolButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="8" Padding="9,6">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 聊天功能键（ToggleButton 版）：与 ChatToolButtonStyle 同视觉，供截图下拉托盘开关使用 -->
        <Style x:Key="ChatToolButtonToggleStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="8" Padding="9,6">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentAltBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 左下角设置齿轮：与导航项同视觉，选中态强调色 -->
        <Style x:Key="GearButtonStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Background="{DynamicResource SurfaceBrush}" CornerRadius="12"
                                Padding="14,11" Margin="8,2" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentAltBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    <!-- 微信式现代滚动条：细窄半透明圆条，悬停加深、无箭头按钮与轨道底色 -->
        <Style x:Key="ScrollThumbModern" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Tb" CornerRadius="3" Background="{DynamicResource TextSecondaryBrush}"
                                Opacity="0" HorizontalAlignment="Right" Width="4" SnapsToDevicePixels="True"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tb" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollPageModern" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollBarModernV" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPageModern}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumbModern}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPageModern}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 传输记录区的简化模板：仅纵向现代滚动条（水平已禁用），内容区撑满 -->
        <Style x:Key="ChatScrollerStyle" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                    Margin="{TemplateBinding Padding}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Width="8" Margin="0,0,-6,0"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Style="{StaticResource ScrollBarModernV}" Orientation="Vertical"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 通用现代滚动条样式（无负边距，不溢出容器）：设置页/反馈页等用 -->
        <Style x:Key="ModernScrollerStyle" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                    Margin="{TemplateBinding Padding}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Width="8" Margin="0,0,0,0"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Style="{StaticResource ScrollBarModernV}" Orientation="Vertical"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 自绘标题栏：左侧品牌，右侧窗口按钮 -->
        <Grid Height="44" VerticalAlignment="Top" Background="{DynamicResource BgBrush}"
              MouseLeftButtonDown="TitleBar_MouseLeftDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/Assets/logo.png" Width="26" Height="26" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                <TextBlock Text="OrangeGO" FontSize="13" FontWeight="Bold" Margin="9,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource WinButtonStyle}" Click="MinButton_Click">
                    <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center"/>
                </Button>
                <Button Style="{StaticResource WinButtonStyle}" Click="MaxButton_Click">
                    <TextBlock x:Name="MaxGlyph" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center"/>
                </Button>
                <Button Style="{StaticResource WinCloseStyle}" Click="CloseButton_Click">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 主体 -->
        <Grid Margin="0,44,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 侧边导航 -->
            <Grid Grid.Column="0" Margin="6,12,6,0" Background="{DynamicResource BgBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Nav.QuickTools}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="20,0,0,8"/>
                    <RadioButton x:Name="NavTransfer" Style="{StaticResource NavItemStyle}" GroupName="Nav" IsChecked="True"
                                 Content="{DynamicResource Nav.Transfer}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavDevices" Style="{StaticResource NavItemStyle}" GroupName="Nav"
                                 Content="{DynamicResource Nav.Devices}" Checked="Nav_Checked"/>
                </StackPanel>
                <Border x:Name="IncomingBadge" CornerRadius="10" Background="{DynamicResource DangerBrush}"
                        MinWidth="18" Height="18" Padding="5,0" Margin="0,22,16,0"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
                    <TextBlock x:Name="IncomingBadgeText" Text="0" Foreground="White" FontSize="10"
                               FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <!-- 左下角设置齿轮入口 -->
                <ToggleButton x:Name="GearButton" Grid.Row="1" Margin="0,4,0,0"
                              Style="{StaticResource GearButtonStyle}" Checked="Gear_Checked" Unchecked="Gear_Unchecked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="GearLabel" Text="{DynamicResource Nav.Settings}" FontSize="13" FontWeight="SemiBold"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>
            </Grid>

            <!-- 内容区：白色区域左贴导航右边界、上贴标题栏下边界；内部为文本框等留空隙（微信式分区） -->
            <Border Grid.Column="1" Margin="0,0,12,0" Padding="12,12,12,12" Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="12" ClipToBounds="True"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>

                <!-- 设备页 -->
                <Grid x:Name="DevicePage">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=NavDevices}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/> <!-- 收藏夹折叠面板 -->
                        <RowDefinition Height="Auto"/> <!-- 发送条 -->
                    </Grid.RowDefinitions>
                    <Grid Margin="4,2,8,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Page.Devices}" Style="{StaticResource PageHeaderStyle}"/>
                            <TextBlock Text="{DynamicResource Devices.Subtitle}"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  AllowDrop="True" DragOver="DeviceArea_DragOver" Drop="DeviceArea_Drop">
                        <Grid>
                            <ListBox x:Name="DeviceList" ItemsSource="{Binding Peers}"
                                     SelectionMode="Extended"
                                     BorderThickness="0" Background="Transparent"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     SelectionChanged="DeviceList_SelectionChanged"
                                     PreviewMouseLeftButtonDown="DeviceList_PreviewMouseLeftButtonDown">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource DeviceTileStyle}">
                                        <EventSetter Event="Drop" Handler="DeviceTile_Drop"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                            <!-- 空状态 -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Peers.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{DynamicResource Devices.Empty}" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Devices.EmptyHint}" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- 收藏夹折叠面板（移至最底部，折叠式默认收起） -->
                    <Border Grid.Row="2" Margin="0,10,0,0" CornerRadius="16" Padding="0"
                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- 折叠标题栏 -->
                            <Grid Grid.Row="0" Margin="14,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource Devices.Favorites}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <ToggleButton x:Name="FavToggle" Grid.Column="1" VerticalAlignment="Center"
                                              IsChecked="False" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Btn" Background="Transparent" CornerRadius="8" Padding="10,4">
                                                <!-- 折叠箭头：收起时朝上（↑ 表示"展开"），展开时朝下（↓ 表示"收起"） -->
                                                <Path x:Name="Chev"
                                                      Data="M7.41,15.41L12,10.83l4.59,4.58L18,14l-6,-6 -6,6z"
                                                      Fill="{DynamicResource TextSecondaryBrush}"
                                                      Width="15" Height="15" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Chev" Property="Data"
                                                            Value="M7.41,8.58L12,13.17l4.59,-4.59L18,10l-6,6 -6,-6z"/>
                                                    <Setter TargetName="Chev" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Btn" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>
                            <!-- 收藏夹列表面板 -->
                            <Border Grid.Row="1" Margin="0,0,0,10" Padding="14,10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=FavToggle}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding Favorites}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="10" Padding="10,6" Margin="0,6,8,0"
                                                        Background="{DynamicResource SurfaceAltBrush}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <!-- 收藏条目显示：设备名 + 短标识（设备ID，唯一且不随 IP 变化，区分同型号多台） -->
                                                        <StackPanel Orientation="Vertical">
                                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                                                            <TextBlock Text="{Binding ShortId}" FontSize="10"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                                Click="RemoveFavorite_Click" Tag="{Binding}" Cursor="Hand"
                                                                Background="Transparent" BorderThickness="0"
                                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                                VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{DynamicResource Devices.FavoritesEmpty}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Favorites.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 发送条 -->
                    <Border Grid.Row="3" CornerRadius="16" Padding="14,10" Margin="0,10,0,0"
                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- 已选设备计数的 Material 开源矢量图标（devices）：monitor + phone -->
                                    <Path Data="M4,6h18V4H4C2.9,4 2,4.9 2,6v11H0v3h14v-3H4V6z M23,8h-6c-0.55,0 -1,0.45 -1,1v10c0,0.55 0.45,1 1,1h6c0.55,0 1,-0.45 1,-1V9c0,-0.55 -0.45,-1 -1,-1z M22,18h-4v-7h4v7z"
                                          Fill="{DynamicResource TextSecondaryBrush}" Width="18" Height="18" Stretch="Uniform"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedLabel}" FontSize="13" Margin="8,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="{DynamicResource Devices.StartTransfer}" Style="{StaticResource PrimaryButtonStyle}"
                                        IsEnabled="{Binding HasSelection}" Click="StartTransfer_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 传输页（默认主页：微信式聊天记录 + 文本输入） -->
                <!-- Background=Transparent：让整页（含间隙/圆角缺口）连续命中为同一拖放区域，杜绝边界禁止与提示闪烁 -->
                <Grid x:Name="TransferPage" AllowDrop="True" Background="Transparent">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=NavTransfer}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="4,2,0,10">
                        <TextBlock Text="{DynamicResource Page.Transfer}" Style="{StaticResource PageHeaderStyle}"/>
                        <TextBlock Text="{DynamicResource Transfer.Subtitle}"
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- 聊天记录区 -->
                    <ScrollViewer x:Name="ChatScroller" Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Style="{StaticResource ChatScrollerStyle}"
                                  ScrollChanged="ChatScroller_ScrollChanged"
                                   PreviewMouseWheel="ChatScroller_PreviewMouseWheel">
                        <Grid>
                            <StackPanel>
                                <!-- 聊天气泡列表 -->
                                <ItemsControl ItemsSource="{Binding Transfers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- 背景设为透明：让整条消息行（含时间戳右侧、气泡间等空白区）都参与命中测试，
                                                 多选模式下点击任意空白处都能选中该行（微信式） -->
                                            <Grid Margin="0,5,0,5" Background="Transparent" PreviewMouseLeftButtonUp="Bubble_MouseUp">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <!-- 多选高亮：选中时整行淡橙垫底（置于最底层，气泡画在上方） -->
                                            <Border x:Name="SelOverlay" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                    CornerRadius="12" Background="{DynamicResource SelectionBrush}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <!-- 多选圆圈（微信式）：消息行最左侧、气泡竖直居中，仅多选模式显示；
                                                 点选区域为整行（行根 PreviewMouseLeftButtonUp 隧道处理，先于气泡内的预览/播放点击） -->
                                            <Grid x:Name="SelCircle" Grid.Row="0" Grid.Column="0" Width="22" Height="22"
                                                  Margin="2,0,10,0" VerticalAlignment="Center">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.IsMultiSelect, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <!-- 未选：空心圈 -->
                                                <Ellipse Width="18" Height="18" Stroke="{DynamicResource TextSecondaryBrush}"
                                                         StrokeThickness="1.6" Opacity="0.55"/>
                                                <!-- 已选：实心橙圈 + 白对勾 -->
                                                <Grid>
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Ellipse Width="18" Height="18" Fill="{DynamicResource AccentBrush}"/>
                                                    <Path Data="M4.69 7.55 L6.45 8.87 L9.64 5.13" Stroke="White" StrokeThickness="1.8"
                                                          Stretch="Uniform" Width="12" Height="12"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                </Grid>
                                            </Grid>

                                                <!-- 气泡外信息行：发给/来自 + 进度 + 时间 -->
                                                <StackPanel x:Name="InfoPanel" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,2,6,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Direction}" Value="发送">
                                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Recalled}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="{Binding MetaLabel}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding TimeText}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                    <!-- WhatsApp 式小圆环：传输中显示进度弧，完成/成功变为「圆圈+对勾」；位于信息行最右侧 -->
                                                    <Grid Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsText}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>
                                                        <!-- 传输中：圆形进度弧（11x11 坐标系，与完成态 Ellipse 11x11 同径同 stroke） -->
                                                        <Grid Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <!-- 背景圆环 -->
                                                            <Ellipse Width="11" Height="11" Fill="Transparent"
                                                                     Stroke="{DynamicResource SurfaceAltBrush}" StrokeThickness="1.6"/>
                                                            <!-- 进度弧 -->
                                                            <Path Data="{Binding Progress, Converter={StaticResource RingConv}}"
                                                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                                                <Path.Style>
                                                                    <Style TargetType="Path">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Progress}" Value="1">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding State}" Value="已完成">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding State}" Value="失败">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding State}" Value="被拒">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding State}" Value="已取消">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Path.Style>
                                                            </Path>
                                                        </Grid>
                                                        <!-- 完成/成功：圆圈 + 对勾 -->
                                                        <Grid>
                                                            <Grid.Style>
                                                                <Style TargetType="Grid">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Progress}" Value="1">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding State}" Value="已完成">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding State}" Value="失败">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding State}" Value="被拒">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding State}" Value="已取消">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Grid.Style>
                                                            <Ellipse Width="11" Height="11" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.6"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <!-- 对勾：比例与安卓端完全一致；完成时通过 StrokeDashOffset 动画从左到右渐渐画出 -->
                                                            <Path Data="M3.02 6.05 L4.78 7.37 L7.97 3.63" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.6"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                  StrokeDashArray="7.2" StrokeDashOffset="7.2"
                                                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                                <Path.Style>
                                                                    <Style TargetType="Path">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Progress}" Value="1">
                                                                                <DataTrigger.EnterActions>
                                                                                    <BeginStoryboard>
                                                                                        <Storyboard>
                                                                                            <DoubleAnimation Storyboard.TargetProperty="StrokeDashOffset" From="7.2" To="0" Duration="0:0:0.45">
                                                                                                <DoubleAnimation.EasingFunction>
                                                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                                                </DoubleAnimation.EasingFunction>
                                                                                            </DoubleAnimation>
                                                                                        </Storyboard>
                                                                                    </BeginStoryboard>
                                                                                </DataTrigger.EnterActions>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding State}" Value="已完成">
                                                                                <DataTrigger.EnterActions>
                                                                                    <BeginStoryboard>
                                                                                        <Storyboard>
                                                                                            <DoubleAnimation Storyboard.TargetProperty="StrokeDashOffset" From="7.2" To="0" Duration="0:0:0.45">
                                                                                                <DoubleAnimation.EasingFunction>
                                                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                                                </DoubleAnimation.EasingFunction>
                                                                                            </DoubleAnimation>
                                                                                        </Storyboard>
                                                                                    </BeginStoryboard>
                                                                                </DataTrigger.EnterActions>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Path.Style>
                                                            </Path>
                                                        </Grid>
                                                        <!-- 失败/被拒/已取消：圆圈 + 叉叉（失败/被拒红叉，已取消次级色叉） -->
                                                        <Grid>
                                                            <Grid.Style>
                                                                <Style TargetType="Grid">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding State}" Value="失败">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding State}" Value="被拒">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding State}" Value="已取消">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Grid.Style>
                                                            <Ellipse Width="11" Height="11" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.6"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <!-- 失败/被拒：红叉（短叉，不碰到外圈） -->
                                                            <Path Data="M3.95 3.95 L7.05 7.05 M7.05 3.95 L3.95 7.05" Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.5"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                                <Path.Style>
                                                                    <Style TargetType="Path">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding State}" Value="已取消">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Path.Style>
                                                            </Path>
                                                            <!-- 已取消：次级色叉（短叉，不碰到外圈） -->
                                                            <Path Data="M3.95 3.95 L7.05 7.05 M7.05 3.95 L3.95 7.05" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                                <Path.Style>
                                                                    <Style TargetType="Path">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding State}" Value="已取消">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Path.Style>
                                                            </Path>
                                                        </Grid>
                                                    </Grid>
                                                </StackPanel>

                                                <!-- 信息气泡：发送靠右、接收靠左 -->
                                                <Border Grid.Row="0" Grid.Column="1" x:Name="BubbleWrap" MaxWidth="560" Margin="6,3,6,0" CornerRadius="14" MouseRightButtonUp="BubbleContext_MouseRightButtonUp">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <!-- 背景必须走 Style Setter：本地值会压死下方所有触发器，导致独立气泡模式无法透明 -->
                                                            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Direction}" Value="发送">
                                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                                    <Setter Property="Background" Value="{DynamicResource AccentAltBrush}"/>
                                                                </DataTrigger>
                                                                <!-- 独立子气泡模式：外层气泡透明无底色，交给每个子气泡自己绘制 -->
                                                                <DataTrigger Binding="{Binding SeparateBubbles}" Value="True">
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Recalled}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border CornerRadius="12" MinHeight="34">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <!-- 文字/文件气泡：左右留白宽于上下（微信式） -->
                                                                <Setter Property="Padding" Value="12,8"/>
                                                                <Style.Triggers>
                                                                    <!-- 纯媒体气泡：四边留白完全一致，避免上下左右不对称 -->
                                                                    <DataTrigger Binding="{Binding IsMediaBubble}" Value="True">
                                                                        <Setter Property="Padding" Value="8"/>
                                                                    </DataTrigger>
                                                                    <!-- 独立子气泡模式：内层不再留白，间距由子气泡自己管理 -->
                                                                    <DataTrigger Binding="{Binding SeparateBubbles}" Value="True">
                                                                        <Setter Property="Padding" Value="0"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                        <!-- 文件传输视图 -->
                                                        <StackPanel>
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsText}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <!-- 视频预览（发送的视频传输记录首帧卡）；外层气泡已统一 8 留白，此处不再额外加底部间距 -->
                                                            <Border Margin="0" CornerRadius="8" ClipToBounds="True" Background="Black"
                                                                    Cursor="Hand" Tag="8" SizeChanged="RoundedClipBorder_SizeChanged"
                                                                    MouseLeftButtonUp="PreviewMedia_MouseUp">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsVideo}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <Grid Height="150">
                                                                    <Image Source="{Binding Thumb}" Stretch="Uniform"/>
                                                                    <Border Background="#AA000000" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                            CornerRadius="22" Width="44" Height="44">
                                                                        <Path Data="M7 4 L20 12 L7 20 Z" Fill="White" Width="16" Height="17" Stretch="Uniform"
                                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                            <!-- 图片预览（微信式：按比例完整显示，不裁切；集成网格启用时隐藏） -->
                                                            <!-- 圆角裁剪在 SizeChanged 时按实际尺寸生成（可靠），不再依赖绑定时间点可能为 0 的动态 Rect -->
                                                            <Border Margin="0" CornerRadius="14" Background="{DynamicResource SurfaceBrush}" Cursor="Hand"
                                                                    MouseLeftButtonUp="PreviewMedia_MouseUp" Tag="14"
                                                                    SizeChanged="RoundedClipBorder_SizeChanged">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ShowSingleImagePreview}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <Grid MaxWidth="320" MinWidth="180" MinHeight="120">
                                                                    <Image Source="{Binding Thumb}" Stretch="Uniform"
                                                                           MaxWidth="300" MaxHeight="220" VerticalAlignment="Center">
                                                                        <Image.Style>
                                                                            <Style TargetType="Image">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HeicUnavailable}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Image.Style>
                                                                    </Image>
                                                                    <!-- HEIC 缺解码器提示 -->
                                                                    <Border Tag="HeicHint" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="12"
                                                                            Margin="10" Padding="16,14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                            MaxWidth="300">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HeicUnavailable}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <StackPanel>
                                                                            <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                                       HorizontalAlignment="Center"/>
                                                                            <TextBlock Margin="0,10,0,0" FontSize="12" LineHeight="18" TextWrapping="Wrap"
                                                                                       TextAlignment="Center"
                                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                                       Text="{DynamicResource Msg.HeifNoPreview}"/>
                                                                            <TextBlock Margin="0,8,0,0" FontSize="12" TextAlignment="Center">
                                                                                <Hyperlink RequestNavigate="InstallHeifLink_Click"
                                                                                           Foreground="{DynamicResource AccentBrush}"
                                                                                           TextDecorations="Underline">
                                                                                    <Run Text="{DynamicResource Msg.HeifGoInstall}"/>
                                                                                </Hyperlink>
                                                                            </TextBlock>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                            <!-- 文件集成网格（设置「文件集成显示」开启 & 多文件 & 含图片/视频：固定较小缩略图合并展示，不做完整预览） -->
                                                            <!-- 缩略图用均匀 3 外边距 + 容器 -3 负边距：相邻间隔 6，最外圈不留额外空白，四边与气泡 Padding 严格一致 -->
                                                            <ItemsControl ItemsSource="{Binding MediaGridItems}" Margin="-3">
                                                                <ItemsControl.Style>
                                                                    <Style TargetType="ItemsControl">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IntegratedGrid}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ItemsControl.Style>
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel Orientation="Horizontal"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Width="84" Height="84" Margin="3" CornerRadius="10" Cursor="Hand"
                                                                                Background="{DynamicResource SurfaceBrush}"
                                                                                MouseLeftButtonUp="IntegratedThumb_MouseUp" Tag="10"
                                                                                SizeChanged="RoundedClipBorder_SizeChanged">
                                                                            <Grid>
                                                                                <!-- 图片缩略图：居中裁切。
                     注意：WPF 的 Image+UniformToFill 溢出内容锚定左上（实验验证），
                     必须用 ImageBrush 的 AlignmentX/Y=Center 才是真正的居中裁切（与安卓 ContentScale.Crop 一致） -->
                                                                                <Border Width="84" Height="84">
                                                                                    <Border.Style>
                                                                                        <Style TargetType="Border">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Border.Style>
                                                                                    <Border.Background>
                                                                                        <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill"
                                                                                                    AlignmentX="Center" AlignmentY="Center"/>
                                                                                    </Border.Background>
                                                                                </Border>
                                                                                <!-- 视频缩略图：Shell 首帧（居中裁切）+ 中央小播放三角 -->
                                                                                <Border Width="84" Height="84">
                                                                                    <Border.Style>
                                                                                        <Style TargetType="Border">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsVideo}" Value="True">
                                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Border.Style>
                                                                                    <Border.Background>
                                                                                        <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill"
                                                                                                    AlignmentX="Center" AlignmentY="Center"/>
                                                                                    </Border.Background>
                                                                                </Border>
                                                                                <Border Background="#66000000" CornerRadius="13" Width="26" Height="26"
                                                                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                    <Border.Style>
                                                                                        <Style TargetType="Border">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsVideo}" Value="True">
                                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Border.Style>
                                                                                    <Path Data="M7 4 L20 12 L7 20 Z" Fill="White" Width="9" Height="10" Stretch="Uniform"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <!-- 网格内 HEIC 缺解码器提示（占满格，盖住底层） -->
                                                <Border Tag="HeicHint" Background="{DynamicResource SurfaceBrush}" CornerRadius="10">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HeicUnavailable}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6">
                                                        <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Margin="0,4,0,0" FontSize="9" TextWrapping="Wrap" TextAlignment="Center"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   Text="{DynamicResource Msg.HeifShort}"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <!-- 文件卡列表（集成模式下普通文件：图标 + 文件名 + 大小） -->
                                                            <ItemsControl ItemsSource="{Binding FileListItems}" Margin="0,6,0,6">
                                                                <ItemsControl.Style>
                                                                    <Style TargetType="ItemsControl">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ShowFileList}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ItemsControl.Style>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                    <Border CornerRadius="10" Background="{DynamicResource SurfaceBrush}" Padding="10,7" Margin="0,0,0,4"
                                                                            Cursor="Hand" MouseLeftButtonUp="OpenFile_MouseUp">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <!-- Office 品牌图标（Word 蓝 / Excel 绿 / PowerPoint 橙） -->
                                                                                <Image Width="20" Height="20" VerticalAlignment="Center" Stretch="Uniform" Source="{Binding DocIcon}">
                                                                                    <Image.Style>
                                                                                        <Style TargetType="Image">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsOffice}" Value="True">
                                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Image.Style>
                                                                                </Image>
                                                                                <!-- 通用文档字形（非 Office 时兜底） -->
                                                                                <TextBlock Grid.Column="0" Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center">
                                                                                    <TextBlock.Style>
                                                                                        <Style TargetType="TextBlock">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsOffice}" Value="True">
                                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </TextBlock.Style>
                                                                                </TextBlock>
                                                                                <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                                    <TextBlock Text="{Binding SizeText}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <!-- 集成模式体积上限截断后的汇总：等 N 个文件（与安卓端对齐） -->
                                                            <TextBlock FontSize="12" Margin="0,2,0,4"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       Text="{Binding MoreFilesText}" TextAlignment="Right">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ShowMoreFiles}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <!-- 独立子气泡（非集成模式 & 多文件：每个文件各自一个气泡，微信式；子项复用 TransferItem 的缩略图/图标能力） -->
                                                            <ItemsControl ItemsSource="{Binding SubBubbleItems}">
                                                                <ItemsControl.Style>
                                                                    <Style TargetType="ItemsControl">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding SeparateBubbles}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ItemsControl.Style>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <!-- 子气泡：方向决定底色与圆角方向（与安卓 16,16,4,16 / 16,16,16,4 对齐） -->
                                                                        <Border Margin="0,2,0,2" Tag="16" SizeChanged="RoundedClipBorder_SizeChanged" ClipToBounds="True">
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                                                                    <Setter Property="CornerRadius" Value="16,16,16,4"/>
                                                                                    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                                                                    <Setter Property="Padding" Value="12,8"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Direction}" Value="发送">
                                                                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                                                                            <Setter Property="CornerRadius" Value="16,16,4,16"/>
                                                                                            <Setter Property="Background" Value="{DynamicResource AccentAltBrush}"/>
                                                                                        </DataTrigger>
                                                                                        <!-- 媒体子气泡：与安卓一致，图片用 6、视频用 8 的紧凑留白 -->
                                                                                        <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                                                            <Setter Property="Padding" Value="6"/>
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding IsVideo}" Value="True">
                                                                                            <Setter Property="Padding" Value="8"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                            <Grid>
                                                                                <!-- 图片子气泡：完整预览（等比例不裁切） -->
                                                                                <Border CornerRadius="10" Background="{DynamicResource SurfaceBrush}" Tag="10"
                                                                                        SizeChanged="RoundedClipBorder_SizeChanged" Cursor="Hand"
                                                                                        MouseLeftButtonUp="PreviewMedia_MouseUp">
                                                                                    <Border.Style>
                                                                                        <Style TargetType="Border">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Border.Style>
                                                                                    <Image Source="{Binding Thumb}" Stretch="Uniform"
                                                                                           MaxWidth="300" MaxHeight="220"/>
                                                                                </Border>
                                                                                <!-- 视频子气泡：Shell 首帧 + 播放三角 -->
                                                                                <Border Cursor="Hand" CornerRadius="10" Tag="10"
                                                                                        SizeChanged="RoundedClipBorder_SizeChanged"
                                                                                        MouseLeftButtonUp="PreviewMedia_MouseUp">
                                                                                    <Border.Style>
                                                                                        <Style TargetType="Border">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsVideo}" Value="True">
                                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Border.Style>
                                                                                    <Grid Height="150">
                                                                                        <Image Source="{Binding Thumb}" Stretch="Uniform"/>
                                                                                        <Border Background="#AA000000" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                                CornerRadius="22" Width="44" Height="44">
                                                                                            <Path Data="M7 4 L20 12 L7 20 Z" Fill="White" Width="16" Height="17" Stretch="Uniform"
                                                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                        </Border>
                                                                                    </Grid>
                                                                                </Border>
                                                                                <!-- 普通文件子气泡：图标 + 文件名 + 大小 -->
                                                                                <Grid Cursor="Hand" Background="Transparent" MouseLeftButtonUp="OpenFile_MouseUp">
                                                                                    <Grid.Style>
                                                                                        <Style TargetType="Grid">
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                </DataTrigger>
                                                                                                <DataTrigger Binding="{Binding IsVideo}" Value="True">
                                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Grid.Style>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <!-- Office 品牌图标（Word 蓝 / Excel 绿 / PowerPoint 橙） -->
                                                                                    <Image Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0" Stretch="Uniform" Source="{Binding DocIcon}">
                                                                                        <Image.Style>
                                                                                            <Style TargetType="Image">
                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding IsOffice}" Value="True">
                                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </Image.Style>
                                                                                    </Image>
                                                                                    <!-- 通用文档字形（非 Office 时兜底） -->
                                                                                    <TextBlock Grid.Column="0" Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                                                                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                                        <TextBlock.Style>
                                                                                            <Style TargetType="TextBlock">
                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding IsOffice}" Value="True">
                                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </TextBlock.Style>
                                                                                    </TextBlock>
                                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                                        <TextBlock Text="{Binding SizeText}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                                                    </StackPanel>
                                                                                </Grid>
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <!-- 音频预览（传输记录里的音频播放条） -->
                                                            <Border Margin="0,0,0,8" CornerRadius="8" Padding="12,8" Background="{DynamicResource SurfaceBrush}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsAudio}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <Grid Width="250">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <!-- 必须手动播放：默认 LoadedBehavior=Play 会导致打开应用自动播放历史视频/音频的声音 -->
                                                                    <MediaElement x:Name="BubbleAudio" Margin="34,0,0,0" Width="0" Height="0"
                                                                                  Source="{Binding MediaPath}" LoadedBehavior="Manual" UnloadedBehavior="Manual"/>
                                                                    <Button x:Name="AudioPlayBtn" Width="26" Height="26" Background="Transparent" BorderThickness="0"
                                                                            Cursor="Hand" Tag="{Binding}" Click="AudioPlay_Click"
                                                                            ToolTip="{DynamicResource Transfer.PlayPause}">
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="btnBorder" Width="26" Height="26" CornerRadius="13"
                                                                                        Background="{DynamicResource AccentBrush}">
                                                                                    <Path Data="M8 5 L19 13 L8 21 Z" Fill="White" Width="11" Height="12" Stretch="Uniform"
                                                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="btnBorder" Property="Opacity" Value="0.8"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                    </Button>
                                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Text="{Binding State}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Button Grid.Column="2" x:Name="CancelBtn" Content="{DynamicResource Transfer.Cancel}" FontSize="11" Margin="0,0,0,0" Padding="8,2"
                                                                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}"
                                                                        Cursor="Hand" Click="CancelTransfer_Click">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <!-- 仅发送中显示；终态(完成/失败/撤回)隐藏，避免完成后残留 -->
                                                                                <DataTrigger Binding="{Binding ShowCancel}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                            </Grid>
                                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0" VerticalAlignment="Center" Cursor="Hand" Background="Transparent" MouseLeftButtonUp="OpenFile_MouseUp">
                                                                <StackPanel.Style>
                                                                    <Style TargetType="StackPanel">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsVideo}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <!-- 集成网格已展示缩略图，不再重复显示"N 个文件"文字 -->
                                                                            <DataTrigger Binding="{Binding IntegratedGrid}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <!-- 多文件记录：缩略图/文件卡/独立气泡已展示内容，底部名称行不再重复 -->
                                                                            <DataTrigger Binding="{Binding HasMultipleFiles}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </StackPanel.Style>
                                                                <!-- Office 品牌图标（Word 蓝 / Excel 绿 / PowerPoint 橙） -->
                                                                <Image Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0" Stretch="Uniform" Source="{Binding DocIcon}">
                                                                    <Image.Style>
                                                                        <Style TargetType="Image">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsOffice}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Image.Style>
                                                                </Image>
                                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <!-- 接收进度行：传输中在气泡底部显示剩余时间 + 已接收/总大小 -->
                                                            <TextBlock Text="{Binding ProgressText}" FontSize="11" Margin="0,4,0,0"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding StateKey}" Value="Progress">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <!-- 文字消息视图 -->
                                                        <StackPanel>
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsText}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <TextBlock Text="{Binding Content}" FontSize="13" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    </Border>
                                                </Border>

                                                <!-- 已撤回：居中灰字提示（横跨左勾列+内容列，真正整行居中） -->
                                                <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2" Text="{Binding RecalledText}" FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Recalled}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 待确认的接收请求（对端请求发送文件时出现）；放在列表最下方，便于收到即见、就地处理 -->
                                <StackPanel Margin="0,0,0,6">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Incoming.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Border CornerRadius="14" Padding="12" Margin="2,2,2,4" Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Transfer.Incoming}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <ItemsControl ItemsSource="{Binding Incoming}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="14" Padding="14" Margin="0,4,0,4"
                                                                Background="{DynamicResource SurfaceAltBrush}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentAltBrush}" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Initial}" FontSize="16" FontWeight="Bold"
                                                                               Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Summary}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                    <TextBlock Text="{DynamicResource Transfer.SaveToFolder}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Button Content="{DynamicResource Transfer.Decline}" Style="{StaticResource GhostButtonStyle}" Padding="12,6" Click="RejectClick" Tag="{Binding}"/>
                                                                    <Button Content="{DynamicResource Transfer.Accept}" Style="{StaticResource PrimaryButtonStyle}" Padding="14,6" Margin="8,0,0,0" Click="AcceptClick" Tag="{Binding}"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- 空状态：无消息也无接收请求时显示 -->
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Transfers.Count}" Value="0"/>
                                                    <Condition Binding="{Binding Incoming.Count}" Value="0"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Transfer.Empty}" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Transfer.EmptyHint}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </ScrollViewer>

                    <!-- 多选操作栏：进入多选模式后显示「已选 N 条 + 删除所选 + 退出」 -->
                    <Border Grid.Row="2" Margin="0,8,0,0" Padding="14,10" CornerRadius="12"
                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowMultiBar}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Transfer.SelectTip}" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectionBarText}" FontSize="13"
                                           Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="{DynamicResource Transfer.SaveAs}"
                                    Style="{StaticResource GhostButtonStyle}" Padding="14,6" Click="SaveAsSelected_Click"/>
                            <Button Grid.Column="3" Content="{DynamicResource Transfer.DeleteSelected}"
                                    Style="{StaticResource DangerButtonStyle}" Padding="14,6" Margin="10,0,0,0" Click="DeleteSelected_Click"/>
                            <Button Grid.Column="4" Content="{DynamicResource Transfer.ExitMultiSelect}"
                                    Style="{StaticResource GhostButtonStyle}" Padding="14,6" Margin="10,0,0,0" Click="ExitMultiSelect_Click"/>
                        </Grid>
                    </Border>

                    <!-- 底部文本输入栏（微信 PC 式：圆角整块输入区 + 底部功能栏） -->
                    <Border Grid.Row="3" Margin="0,10,0,0" CornerRadius="14"
                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid Margin="14,4,10,6">
