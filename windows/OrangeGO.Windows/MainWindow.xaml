                 两行高度上限（108+8 间距 ×2 = 232），超出后内部滚动，与文字输入区行为一致 -->
                            <Border x:Name="PendingPanel" Grid.Row="0" Visibility="Collapsed"
                                    HorizontalAlignment="Left" Margin="0,8,0,0" IsHitTestVisible="True">
                                <ScrollViewer MaxHeight="232" HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <ScrollViewer.Style>
                                        <Style TargetType="ScrollViewer">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ScrollViewer">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                                    Content="{TemplateBinding Content}"
                                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                                    Margin="{TemplateBinding Padding}"/>
                                                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Width="8" Margin="3,0,0,0"
                                                                       Value="{TemplateBinding VerticalOffset}"
                                                                       Maximum="{TemplateBinding ScrollableHeight}"
                                                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                                                       Style="{StaticResource ScrollBarModernV}" Orientation="Vertical"/>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ScrollViewer.Style>
                                    <WrapPanel x:Name="PendingWrap"/>
                                </ScrollViewer>
                            </Border>
                            <!-- 输入区：透明无边框，融入圆角容器。RichTextBox 支持内联彩色 emoji 图片与文字混排（微信式） -->
                            <RichTextBox x:Name="ChatInput" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                         Padding="0,10" FontSize="13" MaxHeight="96"
                                         VerticalContentAlignment="Top"
                                         CaretBrush="{DynamicResource AccentBrush}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         VerticalScrollBarVisibility="Auto"
                                         AllowDrop="False"
                                         PreviewKeyDown="ChatInput_KeyDown"
                                         TextChanged="ChatInput_TextChanged"
                                         ToolTip="{DynamicResource Transfer.InputHint}"/>
                            <!-- 底部功能栏：左侧功能按键，右侧发送 -->
                            <Grid Grid.Row="2" Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- 表情：Font Awesome Classic Regular · face-smile -->
                                    <Button x:Name="EmojiButton" Style="{StaticResource ChatToolButtonStyle}" Click="EmojiButton_Click" ToolTip="{DynamicResource Emoji.Smiley}">
                                        <Path Data="M464 256A208 208 0 1 0 48 256a208 208 0 1 0 416 0zM0 256a256 256 0 1 1 512 0A256 256 0 1 1 0 256zm177.6 62.1C192.8 334.5 218.8 352 256 352s63.2-17.5 78.4-33.9c9-9.7 24.2-10.4 33.9-1.4s10.4 24.2 1.4 33.9c-22 23.8-60 49.4-113.6 49.4s-91.7-25.5-113.6-49.4c-9-9.7-8.4-24.9 1.4-33.9s24.9-8.4 33.9 1.4zM144.4 208a32 32 0 1 1 64 0 32 32 0 1 1 -64 0zm192-32a32 32 0 1 1 0 64 32 32 0 1 1 0-64z"
                                              Stretch="Uniform" Width="17" Height="17" Fill="{DynamicResource TextSecondaryBrush}"/>
                                    </Button>
                                    <!-- 文件：Font Awesome Free v7.3.1 · file-regular (选取单个/多个文件) -->
                                    <Button Style="{StaticResource ChatToolButtonStyle}" Click="SendButton_Click"
                                            ToolTip="选择文件发送">
                                        <Path Data="M304 112L192 112C183.2 112 176 119.2 176 128L176 512C176 520.8 183.2 528 192 528L448 528C456.8 528 464 520.8 464 512L464 272L376 272C336.2 272 304 239.8 304 200L304 112zM444.1 224L352 131.9L352 200C352 213.3 362.7 224 376 224L444.1 224zM128 128C128 92.7 156.7 64 192 64L325.5 64C342.5 64 358.8 70.7 370.8 82.7L493.3 205.3C505.3 217.3 512 233.6 512 250.6L512 512C512 547.3 483.3 576 448 576L192 576C156.7 576 128 547.3 128 512L128 128z"
                                              Stretch="Uniform" Width="18" Height="17" Fill="{DynamicResource TextSecondaryBrush}"/>
                                    </Button>
                                    <!-- 文件夹：Font Awesome Classic Regular · folder (选取整个文件夹) -->
                                    <Button Style="{StaticResource ChatToolButtonStyle}" Click="FolderPick_Click"
                                            ToolTip="选择文件夹发送">
                                        <Path Data="M0 96C0 60.7 28.7 32 64 32H196.1c19.1 0 37.4 7.6 50.9 21.1L289.9 96H448c35.3 0 64 28.7 64 64V416c0 35.3-28.7 64-64 64H64c-35.3 0-64-28.7-64-64V96zM64 80c-8.8 0-16 7.2-16 16V416c0 8.8 7.2 16 16 16H448c8.8 0 16-7.2 16-16V160c0-8.8-7.2-16-16-16H286.6c-10.6 0-20.8-4.2-28.3-11.7L213.1 87c-4.5-4.5-10.6-7-17-7H64z"
                                              Stretch="Uniform" Width="18" Height="17" Fill="{DynamicResource TextSecondaryBrush}"/>
                                    </Button>
                                    <!-- 截图：Font Awesome Classic Solid · scissors（Regular 无剪刀；逆时针转 90°） -->
                                    <Button x:Name="ScreenButton" Style="{StaticResource ChatToolButtonStyle}" Click="Screenshot_Click"
                                            ToolTip="{DynamicResource Shot.Region}">
                                        <Path Data="M256 192l-39.5-39.5c4.9-12.6 7.5-26.2 7.5-40.5C224 50.1 173.9 0 112 0S0 50.1 0 112s50.1 112 112 112c14.3 0 27.9-2.7 40.5-7.5L192 256l-39.5 39.5c-12.6-4.9-26.2-7.5-40.5-7.5C50.1 288 0 338.1 0 400s50.1 112 112 112s112-50.1 112-112c0-14.3-2.7-27.9-7.5-40.5L499.2 76.8c7.1-7.1 7.1-18.5 0-25.6c-28.3-28.3-74.1-28.3-102.4 0L256 192zm22.6 150.6L396.8 460.8c28.3 28.3 74.1 28.3 102.4 0c7.1-7.1 7.1-18.5 0-25.6L342.6 278.6l-64 64zM64 112a48 48 0 1 1 96 0 48 48 0 1 1 -96 0zm48 240a48 48 0 1 1 0 96 48 48 0 1 1 0-96z"
                                              Stretch="Uniform" Width="17" Height="17" Fill="{DynamicResource TextSecondaryBrush}"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
