<Window x:Class="OrangeGO.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="OrangeGO" Height="640" Width="920"
        Icon="pack://application:,,,/Assets/logo.png"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <!-- CaptionHeight=0：右侧三个窗口按钮归我们自绘，四边仍可缩放；DWM 负责圆角 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="PageHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <!-- 右上角窗口按钮：MDL2 标准图标 + 细腻悬停 -->
        <Style x:Key="WinButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WinCloseStyle" TargetType="Button" BasedOn="{StaticResource WinButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource DangerBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 自绘标题栏：左侧品牌，右侧窗口按钮 -->
        <Grid Height="44" VerticalAlignment="Top" Background="{DynamicResource SurfaceBrush}"
              MouseLeftButtonDown="TitleBar_MouseLeftDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <Border Width="24" Height="24" CornerRadius="8" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                    <TextBlock Text="O" FontSize="12" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="OrangeGO" FontSize="13" FontWeight="Bold" Margin="9,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource WinButtonStyle}" Click="MinButton_Click">
                    <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center"/>
                </Button>
                <Button Style="{StaticResource WinButtonStyle}" Click="MaxButton_Click">
                    <TextBlock x:Name="MaxGlyph" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center"/>
                </Button>
                <Button Style="{StaticResource WinCloseStyle}" Click="CloseButton_Click">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 主体 -->
        <Grid Margin="0,44,0,34">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 侧边导航 -->
            <Grid Grid.Column="0" Margin="6,12,6,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="快捷功能" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="20,0,0,8"/>
                    <RadioButton x:Name="NavDevices" Style="{StaticResource NavItemStyle}" GroupName="Nav" IsChecked="True"
                                 Content="设备"/>
                    <RadioButton x:Name="NavReceive" Style="{StaticResource NavItemStyle}" GroupName="Nav" Content="接收"/>
                    <RadioButton x:Name="NavTransfer" Style="{StaticResource NavItemStyle}" GroupName="Nav" Content="传输"/>
                </StackPanel>
                <Border x:Name="IncomingBadge" CornerRadius="10" Background="{DynamicResource DangerBrush}"
                        MinWidth="18" Height="18" Padding="5,0" Margin="0,66,16,0"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
                    <TextBlock x:Name="IncomingBadgeText" Text="0" Foreground="White" FontSize="10"
                               FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- 功能栏左下角：设置 -->
                <Button Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Margin="10,10,0,0" Click="OpenSettings_Click" ToolTip="设置">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="12" Padding="14,10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="设置" FontSize="13" Margin="10,0,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 内容区：三个页面随导航切换 -->
            <Grid Grid.Column="1" Margin="0,12,12,0">

                <!-- 设备页 -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=NavDevices}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="4,2,0,10">
                        <TextBlock Text="设备" Style="{StaticResource PageHeaderStyle}"/>
                        <TextBlock Text="在同网络内发现 OrangeGO 设备，点击或拖入文件即可发送"
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  AllowDrop="True" DragOver="DeviceArea_DragOver" Drop="DeviceArea_Drop">
                        <Grid>
                            <ListBox x:Name="DeviceList" ItemsSource="{Binding Peers}"
                                     SelectedItem="{Binding SelectedPeer}"
                                     BorderThickness="0" Background="Transparent"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource DeviceTileStyle}">
                                        <EventSetter Event="Drop" Handler="DeviceTile_Drop"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                            <!-- 空状态 -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Peers.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="未发现附近设备" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="请确认对端已打开 OrangeGO 并连接到同一网络" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- 发送条 -->
                    <Border Grid.Row="2" CornerRadius="16" Padding="14,10" Margin="0,10,0,0"
                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedLabel}" FontSize="13" Margin="8,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="选择文件发送" Style="{StaticResource PrimaryButtonStyle}"
                                        IsEnabled="{Binding HasSelection}" Click="SendButton_Click"/>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="MsgInput" VerticalContentAlignment="Center"
                                         Padding="10,8" TextWrapping="Wrap"
                                         Background="{DynamicResource SurfaceAltBrush}"
                                         BorderThickness="0"
                                         ToolTip="输入文字，作为即时消息（聊天气泡）发送，不生成文件"/>
                                <Button Grid.Column="1" Content="发送文字" Margin="8,0,0,0"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        IsEnabled="{Binding HasSelection}"
                                        Click="SendText_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 接收页 -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=NavReceive}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="4,2,0,10">
                        <TextBlock Text="接收" Style="{StaticResource PageHeaderStyle}"/>
                        <TextBlock Text="来自其他设备的发送请求会在这里确认"
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Incoming.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ItemsControl ItemsSource="{Binding Incoming}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="16" Padding="16" Margin="0,0,0,10"
                                                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                    Tag="{Binding}" MouseEnter="IncomingCard_Enter">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource AccentAltBrush}" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding Initial}" FontSize="18" FontWeight="Bold"
                                                                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,2,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Summary}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                        <TextBlock Text="接收的文件将保存到收件目录" FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="拒绝" Style="{StaticResource GhostButtonStyle}" Padding="14,8" Click="RejectClick" Tag="{Binding}"/>
                                                        <Button Content="接受" Style="{StaticResource PrimaryButtonStyle}" Padding="16,8" Margin="8,0,0,0" Click="AcceptClick" Tag="{Binding}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <!-- 空状态 -->
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Incoming.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="暂无接收请求" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60,0,0"/>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- 传输页 -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=NavTransfer}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="4,2,0,10">
                        <TextBlock Text="传输" Style="{StaticResource PageHeaderStyle}"/>
                        <TextBlock Text="查看文件发送与接收进度" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Transfers.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ItemsControl ItemsSource="{Binding Transfers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="16" Padding="16" Margin="0,0,0,10"
                                                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                <Grid>
                                                    <!-- 文件传输视图（默认显示；文字消息时折叠） -->
                                                    <Grid>
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsText}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Direction}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                            <TextBlock Text="{Binding Name}" Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text=" → " Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            <TextBlock Text="{Binding Target}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding Percent}" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,4" Maximum="1"
                                                                     Value="{Binding Progress}" Style="{StaticResource ModernProgressBarStyle}"/>
                                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding State}" FontSize="11" Margin="10,10,0,0"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        <Button Grid.Row="1" Grid.Column="1" Content="取消" FontSize="11"
                                                                HorizontalAlignment="Right" VerticalAlignment="Center" Padding="8,3" Margin="0,8,0,0"
                                                                Background="Transparent" BorderThickness="0"
                                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                                Click="CancelTransfer_Click"/>
                                                    </Grid>

                                                    <!-- 文字气泡视图（文字消息时显示；右键'保存为 .txt'） -->
                                                    <Grid>
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsText}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Direction}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                            <TextBlock Text="{Binding Name}" Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text=" → " Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            <TextBlock Text="{Binding Target}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            <TextBlock Text="{Binding State}" FontSize="11" Margin="10,0,0,0"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <Border Grid.Row="1" Margin="0,10,0,0" CornerRadius="12" Padding="12,8"
                                                                Background="{DynamicResource SurfaceAltBrush}" HorizontalAlignment="Left" MaxWidth="560">
                                                            <Border.ContextMenu>
                                                                <ContextMenu>
                                                                    <MenuItem Header="保存为 .txt" Click="SaveText_Click"/>
                                                                </ContextMenu>
                                                            </Border.ContextMenu>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Content}" FontSize="13" TextWrapping="Wrap"/>
                                                                <TextBlock Text="右键保存为 .txt" FontSize="10"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           Margin="0,6,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <TextBlock Text="暂无传输任务" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Transfers.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </ScrollViewer>
                </Grid>

            </Grid>

        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="1" Height="34" VerticalAlignment="Bottom" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Status}" FontSize="12" Margin="8,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding ReceiveDirHint}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="刷新设备" Style="{StaticResource GhostButtonStyle}" Padding="12,5"
                        FontSize="12" Click="RefreshClick" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>