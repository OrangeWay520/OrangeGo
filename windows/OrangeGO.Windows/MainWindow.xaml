                                        </Path>
                                    </Button>
                                    <!-- 截图下拉托盘：切换截图时是否保留本地窗口 -->
                                    <ToggleButton x:Name="ScreenshotOptBtn" Style="{StaticResource ChatToolButtonToggleStyle}"
                                                  Click="ScreenshotOpt_Click" ToolTip="{DynamicResource Shot.KeepWindow}">
                                        <Path Data="M7.41,8.58L12,13.17l4.59,-4.59L18,10l-6,6l-6,-6z"
                                              Stretch="Uniform" Width="12" Height="12" Fill="{DynamicResource TextSecondaryBrush}"/>
                                    </ToggleButton>
                                    <!-- 气泡右键菜单：自绘透明 Popup（AllowsTransparency -> 合成窗口，无系统矩形阴影）。
                                         外层透明留白 Border 给 DropShadowEffect 留出渲染空间：Popup 窗口按内容尺寸裁剪，
                                         若卡片贴边，圆角阴影会被窗口直角边缘切成"四角楔形+底部直角"，留白后阴影完整跟随圆角 -->
                                    <Popup x:Name="BubbleMenuPopup" Placement="MousePoint" StaysOpen="False" AllowsTransparency="True"
                                           HorizontalOffset="-14" VerticalOffset="-14">
                                        <Border Background="Transparent" Padding="22">
                                            <Border Padding="5" MinWidth="168" SnapsToDevicePixels="True" UseLayoutRounding="True"
                                                    Background="{DynamicResource SurfaceBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12"
                                                    DataContext="{Binding DataContext, ElementName=BubbleMenuPopup}">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="-90" Opacity="0.22" Color="#000000"/>
                                                </Border.Effect>
                                            <StackPanel>
                                                <!-- 仅文字气泡：保存为文本 -->
                                                <Button Click="SaveText_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource PopupMenuItemButtonStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsText}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="M64 0C28.7 0 0 28.7 0 64V448c0 35.3 28.7 64 64 64H320c35.3 0 64-28.7 64-64V160H256c-17.7 0-32-14.3-32-32V0H64zM256 0V128H384L256 0zM112 256H272c8.8 0 16 7.2 16 16s-7.2 16-16 16H112c-8.8 0-16-7.2-16-16s7.2-16 16-16zm0 64H240c8.8 0 16 7.2 16 16s-7.2 16-16 16H112c-8.8 0-16-7.2-16-16s7.2-16 16-16zm0 64H272c8.8 0 16 7.2 16 16s-7.2 16-16 16H112c-8.8 0-16-7.2-16-16s7.2-16 16-16z" Stretch="Uniform" Width="16" Height="16" Fill="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock Text="{DynamicResource Transfer.SaveTxt}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <!-- 仅文件/图片/视频：另存为 -->
                                                <Button Click="SaveAs_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource PopupMenuItemButtonStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsText}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="M464 0H160c-17.7 0-32 14.3-32 32V160h32V32H464V352H320v32H464c17.7 0 32-14.3 32-32V32c0-17.7-14.3-32-32-32zM32 224c0-17.7 14.3-32 32-32H320c17.7 0 32 14.3 32 32V480c0 17.7-14.3 32-32 32H64c-17.7 0-32-14.3-32-32V224z" Stretch="Uniform" Width="16" Height="16" Fill="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock Text="{DynamicResource Transfer.SaveAs}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <!-- 仅发送方可撤回（2 分钟内） -->
                                                <Button Click="RecallTransfer_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource PopupMenuItemButtonStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanRecall}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="M205.7 384H240v64H205.7c-33.4 0-65.4-13.3-89-36.9L0 266.6V416c0 17.7 14.3 32 32 32s32-14.3 32-32V224c0-35.3 28.7-64 64-64H311.1l-89.9-89.9c-9.4-9.4-9.4-24.6 0-33.9s24.6-9.4 33.9 0l151 151c9.4 9.4 9.4 24.6 0 33.9l-151 151c-9.4 9.4-24.6 9.4-33.9 0s-9.4-24.6 0-33.9l89.8-89.8H160c-35.3 0-64 28.7-64 64z" Stretch="Uniform" Width="16" Height="16" Fill="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock Text="{DynamicResource Transfer.Recall}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <!-- 多选 -->
                                                <Button Click="MultiSelect_Click" Style="{StaticResource PopupMenuItemButtonStyle}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="M0 80C0 53.5 53.5 0 120 0h240c66.5 0 120 53.5 120 120v240c0 66.5-53.5 120-120 120H120C53.5 480 0 426.5 0 360V80zm128 212.7l60.7 60.7c9.4 9.4 24.6 9.4 33.9 0L384 192c9.4-9.4 9.4-24.6 0-33.9s-24.6-9.4-33.9 0l-133.5 133.5-36.7-36.7c-9.4-9.4-24.6-9.4-33.9 0s-9.4 24.6 0 33.9z" Stretch="Uniform" Width="16" Height="16" Fill="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock Text="{DynamicResource Transfer.MultiSelect}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Border Height="1" Margin="8,2" Background="{DynamicResource BorderBrush}"/>
                                                <!-- 删除 -->
                                                <Button Click="DeleteTransfer_Click" Style="{StaticResource PopupMenuItemButtonStyle}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="M135.2 17.7C140.6 6.8 151.7 0 163.8 0H284.2c12.1 0 23.2 6.8 28.6 17.7L320 32h96c17.7 0 32 14.3 32 32s-14.3 32-32 32H32C14.3 96 0 81.7 0 64S14.3 32 32 32h96l7.2-14.3zM32 128H416V448c0 35.3-28.7 64-64 64H96c-35.3 0-64-28.7-64-64V128zm96 32c-8.8 0-16 7.2-16 16V432c0 8.8 7.2 16 16 16s16-7.2 16-16V176c0-8.8-7.2-16-16-16zm96 0c-8.8 0-16 7.2-16 16V432c0 8.8 7.2 16 16 16s16-7.2 16-16V176c0-8.8-7.2-16-16-16zm96 0c-8.8 0-16 7.2-16 16V432c0 8.8 7.2 16 16 16s16-7.2 16-16V176c0-8.8-7.2-16-16-16z" Stretch="Uniform" Width="16" Height="16" Fill="{DynamicResource DangerBrush}"/>
                                                        <TextBlock Text="{DynamicResource Transfer.Delete}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                            </Border>
                                        </Border>
                                    </Popup>
                                    <Popup x:Name="ScreenshotOptPopup" PlacementTarget="{Binding ElementName=ScreenshotOptBtn}"
                                           Placement="Top" StaysOpen="False" AllowsTransparency="True"
                                           IsOpen="{Binding IsChecked, ElementName=ScreenshotOptBtn, Mode=TwoWay}">
                                        <Border CornerRadius="12" Padding="12,8" Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                UseLayoutRounding="True" MinWidth="220">
                                            <CheckBox x:Name="KeepWindowBox" Content="{DynamicResource Shot.KeepWindow}"
                                                      Click="SettingsToggle_Click"/>
                                        </Border>
                                    </Popup>
                                </StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="8,0" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding SelectedLabel}"
                                           TextTrimming="CharacterEllipsis"/>
                                <Button x:Name="ChatSendBtn" Grid.Column="2" Content="{DynamicResource Devices.Send}" Style="{StaticResource PrimaryButtonStyle}" Padding="22,8"
                                        Click="ChatSend_Click" IsEnabled="False"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 表情选择面板（iOS 苹果输入法风格：顶部分类栏 + 多页彩色 Unicode emoji） -->
                    <Popup x:Name="EmojiPopup" PlacementTarget="{Binding ElementName=EmojiButton}"
                           Placement="Top" StaysOpen="False" AllowsTransparency="True">
                        <Border CornerRadius="16" Padding="10" Width="428"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                UseLayoutRounding="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <!-- 顶部分类栏 -->
                                <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                                    <StackPanel x:Name="EmojiCatBar" Orientation="Horizontal"/>
                                </ScrollViewer>
                                <!-- 分类内容区（每类一页） -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="300">
                                    <Grid x:Name="EmojiPages"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Popup>

                    <!-- 文件拖放遮罩：文件拖入本页时铺满置顶，接管整页拖放，
                         使"记录区+输入框+间隙"成为单一上传区域，绕开 TextBox 内置拖放 -->
                    <Border x:Name="DropOverlay" Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="1000"
                            Visibility="Collapsed" Background="Transparent" AllowDrop="True"
                            DragOver="DropOverlay_DragOver" DragLeave="DropOverlay_DragLeave" Drop="DropOverlay_Drop"/>
                </Grid>

                <!-- 设置页（窗口内切换，参照 LocalSend 设置界面：通用/接收分组） -->
                <Grid x:Name="SettingsPage">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=GearButton}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.Resources>
                        <Style x:Key="SecTitle" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                        </Style>
                        <!-- 圆角输入框 -->
                        <Style x:Key="SettingTextBox" TargetType="TextBox">
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <!-- iOS 风格开关（圆角轨道 + 圆形滑块滑动动画） -->
                        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="CheckBox">
                                        <Grid Width="46" Height="26">
                                            <Border x:Name="Track" CornerRadius="13" Background="{DynamicResource SurfaceAltBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                            <Ellipse x:Name="Knob" Width="20" Height="20" Fill="White" Margin="3,0,0,0" HorizontalAlignment="Left">
                                                <Ellipse.RenderTransform>
                                                    <TranslateTransform x:Name="KnobMove"/>
                                                </Ellipse.RenderTransform>
                                                <Ellipse.Effect>
                                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3"/>
                                                </Ellipse.Effect>
                                            </Ellipse>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="KnobMove" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="KnobMove" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <!-- 分段选择（主题） -->
                        <Style x:Key="SegStyle" TargetType="RadioButton">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="Bg" Background="Transparent" CornerRadius="9" Padding="14,7">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              TextElement.FontSize="12" TextElement.FontWeight="SemiBold"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentAltBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <!-- 圆角下拉框（现代风格） -->
                        <Style x:Key="SettingComboStyle" TargetType="ComboBox">
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="MinWidth" Value="160"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBox">
                                        <Grid>
                                            <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"/>
                                            <Grid Margin="{TemplateBinding Padding}">
                                                <ContentPresenter x:Name="Sel"
                                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                                  HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                <Path x:Name="Arrow" Data="M0 0 L8 8 L16 0"
                                                      Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            </Grid>
                                            <!-- 透明覆盖层：整块可点击切换下拉（较旧的 ComboBox 模板必须含 ToggleButton 才会展开） -->
                                            <ToggleButton Focusable="False" Cursor="Hand" ClickMode="Press"
                                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="Transparent"/>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                            <Popup x:Name="PART_Popup" Placement="Bottom"
                                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                   IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                                                   Focusable="False" PopupAnimation="Fade" StaysOpen="False">
                                                <Border Background="{DynamicResource SurfaceBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                        CornerRadius="10" Margin="0,4,0,0"
                                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                        <ItemsPresenter/>
                                                    </ScrollViewer>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsDropDownOpen" Value="True">
                                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <!-- 下拉框列表项 -->
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border x:Name="Bg" CornerRadius="8" Padding="12,8" Margin="4,2">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentAltBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentAltBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <!-- 设置行标签 -->
                        <Style x:Key="RowLabel" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </Grid.Resources>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="4,2,8,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="SettingsBackBtn" Click="SettingsBack_Click" Visibility="Collapsed"
                                Margin="0,0,12,0" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                ToolTip="{DynamicResource Nav.Back}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Border x:Name="Bg" Width="34" Height="34" CornerRadius="17"
                                                Background="{DynamicResource SurfaceAltBrush}"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <Path x:Name="Ar" Data="M15.41,7.41L14,6l-6,6l6,6l1.41,-1.41L10.83,12z"
                                              Width="16" Height="16" Stretch="Uniform"
                                              Fill="{DynamicResource TextPrimaryBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentAltBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="SettingsTitleText" Text="{DynamicResource Nav.Settings}" Style="{StaticResource PageHeaderStyle}"/>
                            <TextBlock x:Name="SettingsSubtitleText" Text="{DynamicResource Settings.Subtitle}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" x:Name="ResetDefaultBtn" Content="{DynamicResource Settings.Reset}" Style="{StaticResource GhostButtonStyle}"
                                Padding="18,8" Margin="0,2,0,0" Click="ResetDefault_Click"/>
                    </Grid>

                    <ScrollViewer x:Name="SettingsMainScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Style="{StaticResource ModernScrollerStyle}" Loaded="ModernScroll_Loaded">
                        <StackPanel Margin="0,0,8,12">
                            <!-- 通用 -->
                            <Border CornerRadius="16" Padding="20,16" Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings.General}" Style="{StaticResource SecTitle}"/>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Settings.DeviceAlias}" Style="{StaticResource RowLabel}"/>
                                        <TextBox x:Name="NameBox" Grid.Column="1" Style="{StaticResource SettingTextBox}"
                                                 Width="220" HorizontalAlignment="Right" LostFocus="SettingsTextBox_LostFocus"/>
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Settings.Theme}" Style="{StaticResource RowLabel}"/>
                                        <Border Grid.Column="1" HorizontalAlignment="Right" Background="{DynamicResource SurfaceAltBrush}"
                                                CornerRadius="12" Padding="4">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="ThemeFollow" GroupName="SgTheme" Style="{StaticResource SegStyle}" Content="{DynamicResource Settings.FollowSystem}" IsChecked="True" Checked="Theme_Changed"/>
                                                <RadioButton x:Name="ThemeLight" GroupName="SgTheme" Style="{StaticResource SegStyle}" Content="{DynamicResource Settings.Light}" Checked="Theme_Changed"/>
                                                <RadioButton x:Name="ThemeDark" GroupName="SgTheme" Style="{StaticResource SegStyle}" Content="{DynamicResource Settings.Dark}" Checked="Theme_Changed"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Settings.Language}" Style="{StaticResource RowLabel}"/>
                                        <ComboBox x:Name="LangBox" Grid.Column="1" HorizontalAlignment="Right"
                                                  Style="{StaticResource SettingComboStyle}" SelectionChanged="LangBox_SelectionChanged"/>
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Settings.MinimizeToTray}" Style="{StaticResource RowLabel}"/>
                                        <CheckBox x:Name="MinimizeTrayBox" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" Click="SettingsToggle_Click"/>
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Settings.AutoStart}" Style="{StaticResource RowLabel}"/>
                                        <CheckBox x:Name="AutoStartBox" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" Click="SettingsToggle_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 接收 -->
                            <Border Margin="0,12,0,0" CornerRadius="16" Padding="20,16" Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings.Receiving}" Style="{StaticResource SecTitle}"/>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Settings.AutoSave}" Style="{StaticResource RowLabel}"/>
                                        <CheckBox x:Name="AutoSaveBox" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" Click="SettingsToggle_Click"/>
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Settings.AutoSaveWhitelist}" Style="{StaticResource RowLabel}" TextWrapping="Wrap"/>
                                        <CheckBox x:Name="AutoSaveWhitelistBox" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" Click="SettingsToggle_Click"/>
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Settings.RequirePin}" Style="{StaticResource RowLabel}"/>
                                        <CheckBox x:Name="RequirePinBox" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" Click="SettingsToggle_Click"/>
                                    </Grid>

                                    <!-- PIN 输入行：启用 PIN 后出现；留空离开设置时自动关闭（逻辑同安卓端） -->
                                    <Grid Margin="0,14,0,0" x:Name="PinRow">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, ElementName=RequirePinBox}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Settings.PinCode}" Style="{StaticResource RowLabel}"/>
                                        <TextBox x:Name="PinBox" Grid.Column="1" Style="{StaticResource SettingTextBox}"
                                                 Width="160" MaxLength="16" HorizontalAlignment="Right" CharacterCasing="Normal" LostFocus="SettingsTextBox_LostFocus"/>
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Settings.AutoComplete}" Style="{StaticResource RowLabel}"/>
                                        <CheckBox x:Name="AutoCompleteBox" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" Click="SettingsToggle_Click"/>
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Settings.SaveHistory}" Style="{StaticResource RowLabel}"/>
                                        <CheckBox x:Name="SaveHistoryBox" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" Click="SettingsToggle_Click"/>
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Settings.SaveDir}" Style="{StaticResource RowLabel}"/>
                                        <TextBox x:Name="DirBox" Grid.Column="1" Style="{StaticResource SettingTextBox}"
                                                 Margin="12,0,8,0" LostFocus="SettingsTextBox_LostFocus"/>
                                        <Button Grid.Column="2" Content="{DynamicResource Settings.Browse}" Style="{StaticResource GhostButtonStyle}" Padding="14,8" Click="BrowseDir_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 传输 -->
                            <Border Margin="0,12,0,0" CornerRadius="16" Padding="20,16" Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings.TransfersGroup}" Style="{StaticResource SecTitle}"/>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Settings.IntegrateImages}" Style="{StaticResource RowLabel}" TextWrapping="Wrap"/>
                                        <CheckBox x:Name="IntegrateImagesBox" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" Click="SettingsToggle_Click"/>
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Settings.ClearHistory}" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/>
                                        <Button x:Name="ClearHistoryBtn" Grid.Column="1"
                                                Content="{DynamicResource Settings.ClearHistoryBtn}" Style="{StaticResource DangerButtonStyle}" Padding="16,8"
                                                Click="ClearHistory_Click"/>
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Settings.AutoCleanup}" Style="{StaticResource RowLabel}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="AutoCleanupBox" Grid.Column="1" Width="150" Style="{StaticResource SettingComboStyle}"
                                                  HorizontalAlignment="Right" SelectionChanged="AutoCleanup_Changed"/>
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Settings.ClearThumbCache}" Style="{StaticResource RowLabel}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="ThumbCacheSizeText" VerticalAlignment="Center" Margin="0,0,14,0" Style="{StaticResource RowLabel}"/>
                                            <Button x:Name="ClearThumbCacheBtn" Content="{DynamicResource Settings.ClearThumbCacheBtn}"
                                                    Style="{StaticResource DangerButtonStyle}" Padding="16,8" Click="ClearThumbCache_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 关于 -->
                            <Border Margin="0,12,0,0" CornerRadius="16" Padding="20,16" Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings.AboutGroup}" Style="{StaticResource SecTitle}"/>

                                    <!-- 检查更新 -->
                                    <Border CornerRadius="12" Margin="0,12,0,0" Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand"
                                            MouseLeftButtonUp="CheckUpdate_Click" Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource AccentAltBrush}" VerticalAlignment="Center">
                                                <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4c-4.42,0 -7.99,3.58 -7.99,8s3.57,8 7.99,8c3.73,0 6.84,-2.55 7.73,-6h-2.08c-0.82,2.33 -3.04,4 -5.65,4 -3.31,0 -6,-2.69 -6,-6s2.69,-6 6,-6c1.66,0 3.14,0.69 4.22,1.78L13,11h7V4l-2.35,2.35z"
                                                      Fill="{DynamicResource AccentBrush}" Width="16" Height="16" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource Settings.CheckUpdate}" FontSize="13"/>
                                                <TextBlock x:Name="UpdateVerText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Path Grid.Column="2"
                                                  Fill="{DynamicResource TextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"
                                          Data="M12,4l-1.41,1.41L16.17,11H4v2h12.17l-5.58,5.59L12,20l8,-8z"/>
                                        </Grid>
                                    </Border>

                                    <!-- 关于应用 -->
                                    <Border CornerRadius="12" Margin="0,8,0,0" Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand"
                                            MouseLeftButtonUp="AboutRow_Click" Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource AccentAltBrush}" VerticalAlignment="Center">
                                                <Path Data="M12,2C6.48,2 2,6.48 2,12s4.48,10 10,10 10,-4.48 10,-10S17.52,2 12,2zM13,17h-2v-6h2v6zM13,9h-2V7h2v2z"
                                                      Fill="{DynamicResource AccentBrush}" Width="16" Height="16" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{DynamicResource Settings.About}" FontSize="13" Margin="10,0,8,0" VerticalAlignment="Center"/>
                                            <Path Grid.Column="2"
                                                  Fill="{DynamicResource TextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"
                                          Data="M12,4l-1.41,1.41L16.17,11H4v2h12.17l-5.58,5.59L12,20l8,-8z"/>
                                        </Grid>
                                    </Border>

                                    <!-- 问题反馈 -->
                                    <Border CornerRadius="12" Margin="0,8,0,0" Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand"
                                            MouseLeftButtonUp="FeedbackRow_Click" Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource AccentAltBrush}" VerticalAlignment="Center">
                                                <Path Data="M20,11v2h4v-2h-4zM16,17.5c0.96,0.71 2.21,1.65 3.2,2.39 0.4,-0.53 0.8,-1.07 1.2,-1.6 -0.99,-0.74 -2.24,-1.68 -3.2,-2.4 -0.4,0.54 -0.8,1.08 -1.2,1.61zM20.4,5.2c-0.4,-0.53 -0.8,-1.07 -1.2,-1.6 -0.99,0.74 -2.24,1.68 -3.2,2.4 0.4,0.53 0.8,1.07 1.2,1.6 0.96,-0.72 2.21,-1.65 3.2,-2.4zM4,9c-1.1,0 -2,0.9 -2,2v2c0,1.1 0.9,2 2,2h1v4h2v-4h1l5,3V6L7,9H4zM15.5,12c0,-1.77 -1.02,-3.29 -2.5,-4.03v8.05c1.48,-0.73 2.5,-2.25 2.5,-4.02z"
                                                      Fill="{DynamicResource AccentBrush}" Width="16" Height="16" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{DynamicResource Settings.Feedback}" FontSize="13" Margin="10,0,8,0" VerticalAlignment="Center"/>
                                            <Path Grid.Column="2"
                                                  Fill="{DynamicResource TextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"
                                          Data="M12,4l-1.41,1.41L16.17,11H4v2h12.17l-5.58,5.59L12,20l8,-8z"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===== 二级页：检查更新 ===== -->
                    <Border Grid.Row="1" x:Name="UpdatePage" Visibility="Collapsed" Margin="0,0,8,12"
                            CornerRadius="16" Padding="20,16" Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Border.Resources>
                            <!-- 更新通道：磁贴式单选（选中橙色描边/底 + 对勾） -->
                            <Style x:Key="SrcTile" TargetType="RadioButton">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="C" CornerRadius="12" Padding="12,10"
                                                    Background="{DynamicResource SurfaceAltBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{TemplateBinding Content}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                    <Border x:Name="Check" Grid.Column="1" Width="19" Height="19" CornerRadius="9.5"
                                                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2"
                                                            Visibility="Collapsed" VerticalAlignment="Center" Margin="8,0,0,0">
                                                        <Path Data="M9,16.17L4.83,12l-1.42,1.41L9,19 21,7l-1.41,-1.41z"
                                                              Fill="{DynamicResource AccentBrush}" Stretch="Uniform" Margin="2"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="C" Property="Background" Value="{DynamicResource AccentAltBrush}"/>
                                                    <Setter TargetName="C" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Border.Resources>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource ModernScrollerStyle}" Loaded="ModernScroll_Loaded">
                            <StackPanel>
                                <!-- 科技感渐变 Hero -->
                                <Border CornerRadius="18" Margin="0,0,0,16" Padding="20,20">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                            <GradientStop Color="#E65100" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Settings.CheckUpdate}" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="White"/>
                                            <TextBlock x:Name="UpdateCurVerText" FontSize="30" FontWeight="Black"
                                                       Foreground="White" Margin="0,6,0,0"/>
                                            <TextBlock Text="{DynamicResource Settings.CurrentVersion}" FontSize="11"
                                                       Foreground="#DDFFFFFF" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border x:Name="UpdateHeroBtn" Grid.Column="1" Width="46" Height="46" CornerRadius="23" Background="#33FFFFFF"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Cursor="Hand" MouseLeftButtonUp="UpdateRecheck_Click"
                                                ToolTip="{DynamicResource Settings.CheckUpdate}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#55FFFFFF"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Path x:Name="UpdateHeroIcon" Data="M17.65,6.35C16.2,4.9 14.21,4 12,4c-4.42,0 -7.99,3.58 -7.99,8s3.57,8 7.99,8c3.73,0 6.84,-2.55 7.73,-6h-2.08c-0.82,2.33 -3.04,4 -5.65,4 -3.31,0 -6,-2.69 -6,-6s2.69,-6 6,-6c1.66,0 3.14,0.69 4.22,1.78L13,11h7V4l-2.35,2.35z"
                                                  Fill="White" Width="24" Height="24" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform>
                                                        <RotateTransform x:Name="UpdateHeroSpin"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- 更新通道（对齐安卓三下载源） -->
                                <Border CornerRadius="12" Padding="14,12" Margin="0,0,0,0"
                                        Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Settings.UpdateSource}" Style="{StaticResource SecTitle}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <RadioButton x:Name="SrcGitCode" GroupName="SgSrc" Style="{StaticResource SrcTile}" Content="GitCode" Tag="gitcode" IsChecked="True" Checked="UpdateSrc_Changed" Margin="0,0,8,0"/>
                                            <RadioButton x:Name="SrcGitee" GroupName="SgSrc" Style="{StaticResource SrcTile}" Content="Gitee" Tag="gitee" Checked="UpdateSrc_Changed" Margin="0,0,8,0"/>
                                            <RadioButton x:Name="SrcGithub" GroupName="SgSrc" Style="{StaticResource SrcTile}" Content="GitHub" Tag="github" Checked="UpdateSrc_Changed"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 状态 / 结果 -->
                                <TextBlock x:Name="UpdateStatusText" Margin="0,18,0,0" FontSize="13" TextWrapping="Wrap"
                                           Text="{DynamicResource Settings.Checking}"/>
                                <StackPanel x:Name="UpdateResultPanel" Visibility="Collapsed" Margin="0,12,0,0">
                                    <TextBlock x:Name="UpdateNewVerText" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                    <Border CornerRadius="12" Padding="12,10" Margin="0,12,0,0"
                                            Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Settings.Changelog}" Style="{StaticResource SecTitle}"/>
                                            <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0"
                                                          Style="{StaticResource ModernScrollerStyle}" Loaded="ModernScroll_Loaded">
                                                <TextBlock x:Name="UpdateChangelog" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{DynamicResource Settings.Assets}" Style="{StaticResource SecTitle}" Margin="0,14,0,4"/>
                                    <ItemsControl x:Name="UpdateAssetsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="10" Padding="12,8" Margin="0,4,0,0"
                                                        Background="{DynamicResource SurfaceAltBrush}" Cursor="Hand"
                                                        MouseLeftButtonUp="AssetRow_Click" Tag="{Binding}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Path Data="M19,9h-4V3H9v6H5l7,7L19,9zM5,18v2h14v-2H5z" Width="14" Height="14" Stretch="Uniform"
                                                              Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Size}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button x:Name="UpdateOpenReleaseBtn" Content="{DynamicResource Settings.OpenRelease}"
                                            Style="{StaticResource GhostButtonStyle}" Margin="0,14,0,0" HorizontalAlignment="Left"
                                            Click="UpdateOpenRelease_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- ===== 二级页：关于 ===== -->
                    <Border Grid.Row="1" x:Name="AboutPage" Visibility="Collapsed" Margin="0,0,8,12"
                            CornerRadius="16" Padding="20,16" Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource ModernScrollerStyle}" Loaded="ModernScroll_Loaded">
                            <StackPanel>
                                <!-- 真实应用图标 -->
                                <Border Width="80" Height="80" CornerRadius="20" ClipToBounds="True" HorizontalAlignment="Center">
                                    <Image Source="pack://application:,,,/Assets/logo.png" Stretch="UniformToFill"/>
                                </Border>
                                <TextBlock Text="OrangeGO" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                                <TextBlock Text="{DynamicResource Settings.Tagline}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <Border HorizontalAlignment="Center" Margin="0,10,0,0" CornerRadius="8" Padding="12,4"
                                        Background="{DynamicResource AccentAltBrush}">
                                    <TextBlock x:Name="AboutVersionText" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                </Border>

                                <!-- 详细信息 -->
                                <Border Margin="0,20,0,0" CornerRadius="12" Padding="14,4" Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource About.SystemVersion}" Style="{StaticResource RowLabel}"/>
                                            <TextBlock x:Name="AboutSystemText" Grid.Column="1" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Grid>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource About.Runtime}" Style="{StaticResource RowLabel}"/>
                                            <TextBlock x:Name="AboutRuntimeText" Grid.Column="1" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 隐私政策：应用内直接展示，不再跳转浏览器 -->
                                <TextBlock Text="{DynamicResource About.Privacy}" Style="{StaticResource SecTitle}" Margin="0,18,0,6"/>
                                <Border CornerRadius="12" Padding="14,12" Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <TextBlock Text="{DynamicResource About.PrivacyText}" FontSize="12" TextWrapping="Wrap"
                                               LineHeight="20" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>

                                <TextBlock Text="{DynamicResource About.Copyright}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- ===== 二级页：问题反馈 ===== -->
                    <Border Grid.Row="1" x:Name="FeedbackPage" Visibility="Collapsed" Margin="0,0,8,12"
                            CornerRadius="16" Padding="20,16" Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource ModernScrollerStyle}" Loaded="ModernScroll_Loaded">
                            <StackPanel>
                                <!-- 顶部说明卡片 -->
                                <Border CornerRadius="12" Background="{DynamicResource AccentAltBrush}" Padding="14,12">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M23,12l-2.44,-2.79l0.34,-3.69l-3.61,-0.82L15.4,1.5L12,3L8.6,1.5L6.71,4.69L3.1,5.5L3.44,9.2L1,12l2.44,2.79l-0.34,3.69l3.61,0.82L8.6,22.5L12,21l3.4,1.5l1.89,-3.19l3.61,-0.82l-0.34,-3.69L23,12zM10,16.17l-3.76,-3.76l1.41,-1.41l2.35,2.35l5.57,-5.57l1.41,1.41L10,16.17z"
                                              Fill="{DynamicResource AccentBrush}" Width="20" Height="20" Stretch="Uniform"
                                              VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBlock x:Name="FeedbackTipText" FontSize="13" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{DynamicResource Feedback.Title}" Style="{StaticResource SecTitle}" Margin="0,16,0,6"/>
                                <TextBox x:Name="FbTitleBox" Style="{StaticResource SettingTextBox}"/>
                                <TextBlock Text="{DynamicResource Feedback.Desc}" Style="{StaticResource SecTitle}" Margin="0,14,0,6"/>
                                <TextBox x:Name="FbDescBox" Style="{StaticResource SettingTextBox}" Height="110"
                                         VerticalContentAlignment="Top" AcceptsReturn="True" TextWrapping="Wrap"/>

                                <!-- 内嵌人机验证 + 提交按键同一行底部对齐 -->
                                <TextBlock x:Name="FbCaptchaHint" Text="{DynamicResource Feedback.CaptchaHint}" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed" Margin="0,14,0,6"/>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="FbCaptchaBorder" Grid.Column="0" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                        <wv2:WebView2 x:Name="FbCaptchaWv" Width="320" Height="110"
                                                      DefaultBackgroundColor="#FFFFFF"/>
                                    </Border>
                                    <Button x:Name="FbSubmitBtn" Grid.Column="1" Content="{DynamicResource Feedback.Submit}" Style="{StaticResource GhostButtonStyle}"
                                            VerticalAlignment="Bottom" HorizontalAlignment="Right" Padding="24,10" Click="FbSubmit_Click"/>
                                </Grid>
                                <TextBlock x:Name="FbStatusText" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- 文件拖放反馈浮层（微信式：拖入文件时顶部提示） -->
                <Border x:Name="DragHint" Panel.ZIndex="999" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0"
                        IsHitTestVisible="False" Cursor="Hand">
                    <Border Background="#DD1F1F1F" CornerRadius="18" Padding="20,10"
                            BorderBrush="#55FFFFFF" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <!-- Font Awesome 上传箭头（arrow-up-from-bracket），白色矢量 -->
                            <Path Data="M224 32c0-17.7 14.3-32 32-32s32 14.3 32 32V243.5l80.7-84.5c12.5-13.1 33.6-13.6 46.7-1.1s13.6 33.6 1.1 46.7L280 382.4c-6.5 6.8-15.5 13.3-24 18.3l0 0c-8.5-5-17.5-11.5-24-18.3L137.3 204.6c-12.5-13.1-12-34.2 1.1-46.7s34.2-12 46.7 1.1L224 243.5V32zM32 416c-17.7 0-32 14.3-32 32s14.3 32 32 32H480c17.7 0 32-14.3 32-32s-14.3-32-32-32H32z"
                                  Fill="White" Width="15" Height="15" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="DragHintText" Text="{DynamicResource Transfer.DropHint}" FontSize="14" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Border>

            </Grid>
        </Border>

        </Grid>

        <!-- 通用确认浮层（替代系统 MessageBox）：整体圆角/配色与主界面一致 -->
        <Grid x:Name="ConfirmOverlay" Panel.ZIndex="1000" Background="#66000000" Visibility="Collapsed"
              PreviewMouseLeftButtonDown="ConfirmOverlay_PreviewMouseLeftButtonDown">
            <Border x:Name="ConfirmCard" Width="392" Padding="0" CornerRadius="18"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="ConfirmScale" ScaleX="0.92" ScaleY="0.92"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- 标题行 -->
                    <Grid Grid.Row="0" Margin="20,16,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="ConfirmIconBadge" Width="26" Height="26" CornerRadius="13"
                                    Background="{DynamicResource AccentAltBrush}">
                                <!-- Font Awesome 图标（开源矢量）；Path 由代码按类型动态设置 -->
                                <Path x:Name="ConfirmIconPath" Data="M135.2 17.7L128 32H32C14.3 32 0 46.3 0 64s14.3 32 32 32h384c17.7 0 32-14.3 32-32s-14.3-32-32-32h-96l-7.2-14.3C307.4 6.8 296.3 0 284.2 0H163.8c-12.1 0-23.2 6.8-28.6 17.7zM416 128H32L53.2 467c1.6 25.3 22.6 45 47.9 45h245.8c25.3 0 46.3-19.7 47.9-45L416 128z"
                                      Fill="{DynamicResource DangerBrush}" Width="13" Height="13" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="ConfirmTitle" FontSize="15" FontWeight="Bold" Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Style="{StaticResource WinCloseStyle}" Click="Confirm_Cancel_Click">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="9"/>
                        </Button>
                    </Grid>
                    <!-- 正文 -->
                    <TextBlock x:Name="ConfirmMessage" Grid.Row="1" Margin="22,16,22,0" FontSize="13"
                               TextWrapping="Wrap" LineHeight="21"/>
                    <!-- PIN 输入行（仅向开启 PIN 的 LocalSend 设备发送时显示） -->
                    <Grid x:Name="PinPanel" Grid.Row="2" Margin="22,16,22,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="PIN" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Margin="0,0,10,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Border Grid.Column="1" Background="{DynamicResource InputBrush}" CornerRadius="8"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10,6">
                            <PasswordBox x:Name="ConfirmPinBox" Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         CaretBrush="{DynamicResource TextPrimaryBrush}"
                                         MaxLength="16" FontSize="13" KeyDown="ConfirmPinBox_KeyDown"/>
                        </Border>
                    </Grid>
                    <!-- 按钮行 -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,18,18">
                        <Button x:Name="ConfirmCancelBtn" Content="{DynamicResource Transfer.Cancel}" Style="{StaticResource GhostButtonStyle}"
                                Padding="18,8" Click="Confirm_Cancel_Click"/>
                        <Button x:Name="ConfirmOkBtn" Style="{StaticResource DangerButtonStyle}" Padding="20,8"
                                Margin="10,0,0,0" Click="Confirm_Ok_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 通用设备选择浮层（替代旧的系统风格弹窗）：与整体 UI 一致 -->
        <Grid x:Name="PickerOverlay" Panel.ZIndex="1000" Background="#66000000" Visibility="Collapsed"
              PreviewMouseLeftButtonDown="PickerOverlay_PreviewMouseLeftButtonDown">
            <Border x:Name="PickerCard" Width="400" CornerRadius="18"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="PickerScale" ScaleX="0.94" ScaleY="0.94"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- 标题行 -->
                    <Grid Grid.Row="0" Margin="20,16,10,8">
                        <TextBlock x:Name="PickerTitle" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Style="{StaticResource WinCloseStyle}" Click="Picker_Cancel_Click">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="9"/>
                        </Button>
                    </Grid>
                    <!-- 设备列表 -->
                    <ScrollViewer Grid.Row="1" Margin="16,0,16,0" VerticalScrollBarVisibility="Auto"
                                  MaxHeight="360" Style="{StaticResource ModernScrollerStyle}" Loaded="ModernScroll_Loaded">
                        <StackPanel x:Name="PickerItems"/>
                    </ScrollViewer>
                    <!-- 底部按钮 -->
                    <Grid Grid.Row="2" Margin="0,16,18,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1" Content="{DynamicResource Transfer.Cancel}" Style="{StaticResource GhostButtonStyle}"
                                Padding="18,8" Click="Picker_Cancel_Click"/>
                        <Button Grid.Column="2" x:Name="PickerOkBtn" Margin="10,0,0,0" Style="{StaticResource PrimaryButtonStyle}"
                                Padding="22,8" IsEnabled="False" Click="Picker_Ok_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
