<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 浅色主题配色（跟随系统浅色模式） -->
    <Color x:Key="BgColor">#F4F5F7</Color>
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#F9FAFB</Color>
    <Color x:Key="BorderColor">#E4E7EB</Color>
    <Color x:Key="TextPrimaryColor">#1B1F27</Color>
    <Color x:Key="TextSecondaryColor">#6B7380</Color>
    <Color x:Key="AccentColor">#FF7A1A</Color>
    <Color x:Key="AccentAltColor">#FFF0E3</Color>
    <Color x:Key="DangerColor">#E5484D</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentAltBrush" Color="{StaticResource AccentAltColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>

</ResourceDictionary>