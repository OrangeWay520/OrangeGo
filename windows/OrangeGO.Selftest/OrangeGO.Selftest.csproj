<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\OrangeGO.Windows\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
    <!-- 这两个文件依赖 WPF 程序集（PresentationCore / PresentationFramework），
         控制台自测工程只跑协议闭环，不需要它们 -->
    <Compile Remove="..\OrangeGO.Windows\Core\ViewModels.cs" />
    <Compile Remove="..\OrangeGO.Windows\Core\ProgressRingConverter.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Haukcode.Mdns" Version="1.0.18" />
  </ItemGroup>

</Project>